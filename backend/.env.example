# Copy this file to .env and fill in real values.

# Leave blank to use a local SQLite file (./aiflow.db) for development.
# For real Postgres, use a URL like:
#   postgresql://username:password@localhost:5432/aiflow
# (Postgres also needs `pip install psycopg2-binary` — left out of
# requirements.txt by default since it can fail to build on some
# Windows setups without Visual C++ Build Tools installed.)
DATABASE_URL=

# Used to sign login tokens. Set this to a long random string before
# deploying anywhere beyond your own machine.
SECRET_KEY=

# Powers the AI Toolkit (grammar improver, summarizer, code explainer).
# Get a key at https://console.anthropic.com — the toolkit endpoints
# return a clear error instead of crashing if this is left blank.
ANTHROPIC_API_KEY=
